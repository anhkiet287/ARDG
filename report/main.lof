\contentsline {figure}{\numberline {6.1}{\ignorespaces Whitebox per-attack robust accuracy (\%) averaged over five seeds. The radar plot compares PGD-AT, DDN-AT, Multi-AT, and AttackDRO++ (Ours) across the eight non-AutoAttack evaluation attacks. The curve shapes summarize the specialist profile of the single-attack baselines and the more balanced profile of the multi-attack methods.}}{73}{figure.caption.44}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Absolute whitebox per-(class \(\times \) attack) robust accuracy for PGD-AT, averaged over five seeds. Cells report robust accuracy (\%).}}{74}{figure.caption.46}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Absolute whitebox per-(class \(\times \) attack) robust accuracy for DDN-AT, averaged over five seeds. Cells report robust accuracy (\%).}}{74}{figure.caption.47}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Absolute whitebox per-(class \(\times \) attack) robust accuracy for Multi-AT, averaged over five seeds. Cells report robust accuracy (\%).}}{75}{figure.caption.48}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Absolute whitebox per-(class \(\times \) attack) robust accuracy for AttackDRO++ (Ours), averaged over five seeds. Cells report robust accuracy (\%).}}{75}{figure.caption.49}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Whitebox per-(class $\times $ attack) delta of AttackDRO++ relative to Multi-AT. Each cell reports AttackDRO++ minus Multi-AT in percentage points, averaged over five seeds.}}{76}{figure.caption.51}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces Whitebox per-(class $\times $ attack) delta of AttackDRO++ (Ours) relative to PGD-AT, averaged over five seeds. Cells report AttackDRO++ minus PGD-AT in percentage points; positive values indicate where AttackDRO++ (Ours) improves over the PGD-$\ell _\infty $ specialist.}}{77}{figure.caption.54}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Whitebox per-(class $\times $ attack) delta of AttackDRO++ (Ours) relative to DDN-AT, averaged over five seeds. Cells report AttackDRO++ minus DDN-AT in percentage points; positive values indicate where AttackDRO++ (Ours) improves over the DDN-$\ell _2$ specialist.}}{78}{figure.caption.55}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Attack-wise whitebox delta of AttackDRO++ relative to the three baselines, averaged over five seeds. Values are AttackDRO++ minus the baseline in percentage points.}}{79}{figure.caption.57}%
\contentsline {figure}{\numberline {6.10}{\ignorespaces Weakest-\(K\) whitebox class--attack lift of AttackDRO++ over each baseline. For each baseline, the weakest-\(K\) cells are the lowest-accuracy class--attack cells of that baseline; bars report AttackDRO++ minus the baseline on those same cells in percentage points, averaged over five seeds.}}{80}{figure.caption.58}%
\contentsline {figure}{\numberline {6.11}{\ignorespaces Method-level graybox transfer matrix on the \(n=5\) panel. Rows are target methods and columns are surrogate methods. Cell values are robust accuracy (\%) averaged over seeds and the eight evaluation attacks.}}{83}{figure.caption.61}%
\contentsline {figure}{\numberline {6.12}{\ignorespaces Per-attack graybox transfer matrices for the \(\ell _\infty \)-oriented attacks. Rows are target methods and columns are surrogate methods; cells report robust accuracy (\%) averaged over target--surrogate seed pairs.}}{84}{figure.caption.62}%
\contentsline {figure}{\numberline {6.13}{\ignorespaces Per-attack graybox transfer matrices for the \(\ell _2\)-oriented attacks. Rows are target methods and columns are surrogate methods; cells report robust accuracy (\%) averaged over target--surrogate seed pairs.}}{85}{figure.caption.63}%
\contentsline {figure}{\numberline {6.14}{\ignorespaces Whitebox--graybox gap heatmap for DDN-AT. Cells report graybox robust accuracy minus whitebox robust accuracy in percentage points; positive values indicate that transferred attacks are weaker than direct whitebox attacks.}}{89}{figure.caption.70}%
\contentsline {figure}{\numberline {6.15}{\ignorespaces Whitebox--graybox gap heatmap for PGD-AT. Cells report graybox robust accuracy minus whitebox robust accuracy in percentage points; positive values indicate that transferred attacks are weaker than direct whitebox attacks.}}{90}{figure.caption.71}%
\contentsline {figure}{\numberline {6.16}{\ignorespaces Whitebox--graybox gap heatmap for Multi-AT. Cells report graybox robust accuracy minus whitebox robust accuracy in percentage points; positive values indicate that transferred attacks are weaker than direct whitebox attacks.}}{90}{figure.caption.72}%
\contentsline {figure}{\numberline {6.17}{\ignorespaces Whitebox--graybox gap heatmap for AttackDRO++ (Ours). Cells report graybox robust accuracy minus whitebox robust accuracy in percentage points; positive values indicate that transferred attacks are weaker than direct whitebox attacks.}}{91}{figure.caption.73}%
\contentsline {figure}{\numberline {6.18}{\ignorespaces Per-(class \(\times \) attack) graybox delta heatmap for AttackDRO++ (Ours) minus Multi-AT. Values are percentage-point differences averaged over the five-seed graybox panel; green favors AttackDRO++ (Ours) and red favors Multi-AT.}}{93}{figure.caption.75}%
\contentsline {figure}{\numberline {6.19}{\ignorespaces Per-(class \(\times \) attack) graybox delta heatmap for AttackDRO++ (Ours) minus PGD-AT. Values are percentage-point differences averaged over the five-seed graybox panel; green favors AttackDRO++ (Ours) and red favors PGD-AT.}}{93}{figure.caption.76}%
\contentsline {figure}{\numberline {6.20}{\ignorespaces Per-(class \(\times \) attack) graybox delta heatmap for AttackDRO++ (Ours) minus DDN-AT. Values are percentage-point differences averaged over the five-seed graybox panel; green favors AttackDRO++ (Ours) and red favors DDN-AT.}}{94}{figure.caption.77}%
\contentsline {figure}{\numberline {6.21}{\ignorespaces Visual decomposition of AttackDRO++ improvement over the single-attack baselines into a multi-attack effect (Multi-AT minus single-AT) and a Cluster-DRO effect (AttackDRO++ minus Multi-AT) across whitebox, cross-method graybox, and bottom-10 cross-method graybox metrics, for the two single-AT decomposition paths. Values are percentage-point differences.}}{96}{figure.caption.80}%
\contentsline {figure}{\numberline {6.22}{\ignorespaces Sensitivity of AttackDRO++ to the number of clusters. The figure reports Mean(8) robust accuracy with the min--max range across available runs. Mean(8) is computed over the eight non-AutoAttack evaluation attacks.}}{98}{figure.caption.82}%
\contentsline {figure}{\numberline {6.23}{\ignorespaces Sensitivity of AttackDRO++ to the anchor strength $\mitlambda _{\mathrm {DRO}}$. The figure reports Mean(8) robust accuracy with the min--max range across available runs. Mean(8) is computed over the eight non-AutoAttack evaluation attacks. The previous $\mitlambda _{\mathrm {DRO}}=1.0$ setting is excluded from the final ablation panel.}}{99}{figure.caption.84}%
\contentsline {figure}{\numberline {6.24}{\ignorespaces Sensitivity of AttackDRO++ to the cluster-refresh interval. The figure reports Mean(8) robust accuracy with the min--max range across available runs. Mean(8) is computed over the eight non-AutoAttack evaluation attacks. The two refresh schedules produce similar results, so the default two-epoch schedule is retained as a practical stability choice.}}{100}{figure.caption.86}%
