\contentsline {figure}{\numberline {5.1}{\ignorespaces Representative W\&B dashboard exports for experiment tracking. Panels (a)--(e) track training loss, training accuracy, clean validation accuracy, and validation robustness under PGD-$\ell _\infty $ and DDN-$\ell _2$ during a training run. Panel (f) records the AttackDRO++ group-weight trajectory diagnostic.}}{57}{figure.caption.30}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Whitebox per-attack robustness profile averaged over five seeds. The radar plot compares PGD-AT, DDN-AT, Multi-AT, and AttackDRO++ (Ours) across the eight non-AutoAttack evaluation attacks. The shape of each curve highlights the specialization of the single-attack baselines and the more balanced profile of the multi-attack methods.}}{67}{figure.caption.45}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Absolute whitebox per-(class \(\times \) attack) robust accuracy for PGD-AT. Cells report robust accuracy (\%).}}{68}{figure.caption.47}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Absolute whitebox per-(class \(\times \) attack) robust accuracy for DDN-AT. Cells report robust accuracy (\%).}}{68}{figure.caption.48}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Absolute whitebox per-(class \(\times \) attack) robust accuracy for Multi-AT. Cells report robust accuracy (\%).}}{69}{figure.caption.49}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Absolute whitebox per-(class \(\times \) attack) robust accuracy for AttackDRO++ (Ours). Cells report robust accuracy (\%).}}{69}{figure.caption.50}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Whitebox per-(class $\times $ attack) delta of AttackDRO++ relative to Multi-AT. Each cell reports AttackDRO++ minus Multi-AT in percentage points, averaged over five seeds.}}{70}{figure.caption.52}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces Whitebox per-(class $\times $ attack) delta of AttackDRO++ (Ours) relative to PGD-AT. Positive cells indicate where AttackDRO++ (Ours) improves over the PGD-$\ell _\infty $ specialist. Gains are concentrated mainly on bounded $\ell _2$ attacks, while PGD-AT remains stronger on several $\ell _\infty $ iterative cells.}}{71}{figure.caption.55}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Whitebox per-(class $\times $ attack) delta of AttackDRO++ (Ours) relative to DDN-AT. The large positive cells under PGD-$\ell _\infty $ and MI-FGSM show that AttackDRO++ (Ours) substantially corrects the $\ell _\infty $ weakness of the DDN-$\ell _2$ specialist, while several negative cells remain on DDN-AT's preferred $\ell _2$ family.}}{72}{figure.caption.56}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Attack-wise whitebox delta of AttackDRO++ relative to the three baselines.}}{73}{figure.caption.58}%
\contentsline {figure}{\numberline {6.10}{\ignorespaces Weakest-\(K\) whitebox class--attack lift of AttackDRO++ over each baseline. For each baseline, the weakest-\(K\) cells are the lowest-accuracy class--attack cells of that baseline; bars report AttackDRO++ minus the baseline on those same cells.}}{74}{figure.caption.59}%
\contentsline {figure}{\numberline {6.11}{\ignorespaces Method-level graybox transfer matrix on the \(n=5\) panel. Rows are target methods and columns are surrogate methods. Cell values are robust accuracy (\%) averaged over seeds and the eight evaluation attacks.}}{77}{figure.caption.62}%
\contentsline {figure}{\numberline {6.12}{\ignorespaces Per-attack graybox transfer matrices for the \(\ell _\infty \)-oriented attacks. Rows are target methods and columns are surrogate methods; cells report robust accuracy (\%).}}{78}{figure.caption.63}%
\contentsline {figure}{\numberline {6.13}{\ignorespaces Per-attack graybox transfer matrices for the \(\ell _2\)-oriented attacks. Rows are target methods and columns are surrogate methods; cells report robust accuracy (\%).}}{79}{figure.caption.64}%
\contentsline {figure}{\numberline {6.14}{\ignorespaces Whitebox--graybox gap heatmap for DDN-AT.}}{83}{figure.caption.71}%
\contentsline {figure}{\numberline {6.15}{\ignorespaces Whitebox--graybox gap heatmap for PGD-AT.}}{84}{figure.caption.72}%
\contentsline {figure}{\numberline {6.16}{\ignorespaces Whitebox--graybox gap heatmap for Multi-AT.}}{84}{figure.caption.73}%
\contentsline {figure}{\numberline {6.17}{\ignorespaces Whitebox--graybox gap heatmap for AttackDRO++ (Ours).}}{85}{figure.caption.74}%
\contentsline {figure}{\numberline {6.18}{\ignorespaces Per-(class \(\times \) attack) graybox delta heatmap for AttackDRO++ (Ours) minus Multi-AT. Green favors AttackDRO++ (Ours); red favors Multi-AT.}}{86}{figure.caption.76}%
\contentsline {figure}{\numberline {6.19}{\ignorespaces Per-(class \(\times \) attack) graybox delta heatmap for AttackDRO++ (Ours) minus PGD-AT. Green favors AttackDRO++ (Ours); red favors PGD-AT.}}{87}{figure.caption.77}%
\contentsline {figure}{\numberline {6.20}{\ignorespaces Per-(class \(\times \) attack) graybox delta heatmap for AttackDRO++ (Ours) minus DDN-AT. Green favors AttackDRO++ (Ours); red favors DDN-AT.}}{87}{figure.caption.78}%
\contentsline {figure}{\numberline {6.21}{\ignorespaces Visual decomposition of AttackDRO++ improvement over the single-attack baselines into a multi-attack effect (Multi-AT minus single-AT) and a Cluster-DRO effect (AttackDRO++ minus Multi-AT) across whitebox, cross-method graybox, and bottom-10 cross-method graybox metrics, for the two single-AT decomposition paths.}}{89}{figure.caption.81}%
\contentsline {figure}{\numberline {6.22}{\ignorespaces Sensitivity of AttackDRO++ to the number of clusters. Mean(8), Worst(8), and AutoAttack-$\ell _\infty $ are reported in percent. Mean(8) and Worst(8) are computed over the eight non-AutoAttack attacks; AutoAttack-$\ell _\infty $ is reported separately.}}{91}{figure.caption.83}%
\contentsline {figure}{\numberline {6.23}{\ignorespaces Sensitivity of AttackDRO++ to the anchor strength $\mitlambda _{\mathrm {DRO}}$. Mean(8), Worst(8), and AutoAttack-$\ell _\infty $ are reported in percent. The previous $\mitlambda _{\mathrm {DRO}}=1.0$ setting is excluded from the final ablation panel.}}{92}{figure.caption.85}%
\contentsline {figure}{\numberline {6.24}{\ignorespaces Sensitivity of AttackDRO++ to the cluster-refresh interval. Mean(8), Worst(8), and AutoAttack-$\ell _\infty $ are reported in percent. The two refresh schedules produce similar results, so the default two-epoch schedule is retained as a practical stability choice.}}{93}{figure.caption.87}%
